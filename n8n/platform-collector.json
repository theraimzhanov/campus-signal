    {
      "id": "normalize-ai-articles",
      "name": "Normalize AI articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        0
      ],
      "parameters": {
        "jsCode": "if($input.first().json.error)return [{json:{action:'error'}}];const items=$input.all().slice(0,40).map(({json:r})=>({title:String(r.title||'').slice(0,300),source_url:r.link,organization:'Hugging Face',location:'Remote',summary:'Source article from the official Hugging Face blog. Read the original for details, examples and limitations.'})).filter(x=>String(x.source_url||'').startsWith('https://huggingface.co/blog/'));return [{json:{action:'news',items}}];"
      }
    },
