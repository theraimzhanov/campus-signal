    {
      "id": "normalize-internships",
      "name": "Normalize Internships",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        230
      ],
      "parameters": {
        "jsCode": "const jobs=$input.first().json.jobs;if(!Array.isArray(jobs))return [{json:{action:'error'}}];const items=jobs.filter(j=>/intern|co.op|student/i.test(j.title||'')&&/software|engineer|data|computer|security|machine learning|research/i.test(j.title||'')).slice(0,80).map(j=>({title:j.title,source_url:j.absolute_url,organization:'Anthropic',location:j.location?.name||'Unknown',summary:'Employer-published student or internship opportunity. Confirm qualifications, work authorization, compensation and current availability at the original listing.'}));return [{json:{action:'internships',items}}];"
      }
    },
