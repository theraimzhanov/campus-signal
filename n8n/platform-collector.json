      "id": "normalize-community-events",
      "name": "Normalize Community events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        920
      ],
      "parameters": {
        "jsCode": "const data=$input.first().json;const html=data.data||data.body||'';if(data.error||!html.includes('event-title'))return [{json:{action:'error'}}];const clean=s=>String(s||'').replace(/<[^>]*>/g,'').replace(/&amp;/g,'&').replace(/\\s+/g,' ').trim();const items=[...html.matchAll(/<li>\\s*<h3 class=\"event-title\">([\\s\\S]*?)<\\/li>/g)].map(m=>{const c=m[1];return {title:clean(c.match(/<a[^>]*>([\\s\\S]*?)<\\/a>/)?.[1]),source_url:'https://www.python.org'+(c.match(/href=\"([^\"]+)\"/)?.[1]||''),location:clean(c.match(/class=\"event-location\">([\\s\\S]*?)<\\/span>/)?.[1])||'Check source',starts_at:c.match(/datetime=\"([^\"]+)\"/)?.[1],organization:'Python community / event organizer',summary:'Conference or community event listed in the official Python events calendar. Follow the source for registration, participation requirements and complete dates.'}}).filter(x=>x.title&&x.source_url.includes('/events/python-events/')&&Date.parse(x.starts_at)>Date.now()).slice(0,40);return [{json:{action:'conferences',items}}]"
