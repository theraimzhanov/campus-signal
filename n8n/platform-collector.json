    {
      "id": "normalize-hackathons",
      "name": "Normalize Hackathons",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        460
      ],
      "parameters": {
        "jsCode": "const data=$input.first().json;const html=data.data||data.body||'';if(data.error||typeof html!=='string'||!html.includes('schema.org/Event'))return [{json:{action:'error'}}];const dec=s=>String(s||'').replace(/&amp;/g,'&').replace(/&#x27;/g,\"'\").replace(/&quot;/g,'\"').replace(/<!--.*?-->/g,'').replace(/<[^>]*>/g,'').trim();const cards=[...html.matchAll(/<a\\b[^>]*itemType=\"https:\\/\\/schema.org\\/Event\"[^>]*>([\\s\\S]*?)<\\/a>/g)];const items=cards.map(m=>{const c=m[1];const meta=k=>c.match(new RegExp('itemProp=\"'+k+'\"[^>]*content=\"([^\"]+)\"'))?.[1];return {title:dec(c.match(/<h4[^>]*>([\\s\\S]*?)<\\/h4>/)?.[1]),source_url:dec(meta('url')),organization:'Major League Hacking / event organizer',location:dec(c.match(/itemProp=\"name\">([\\s\\S]*?)<\\/span>/)?.[1])||'Check source',starts_at:meta('startDate'),ends_at:meta('endDate'),summary:'Hackathon listed on the official MLH season schedule. Check the organizer for registration, eligibility, travel and participation rules.'}}).filter(x=>x.title&&/^https:\\/\\//.test(x.source_url)&&(!x.ends_at||Date.parse(x.ends_at)>Date.now())).slice(0,80);if(!items.length)return [{json:{action:'error'}}];return [{json:{action:'events',items}}];"
      }
    },
