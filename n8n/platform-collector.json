        "jsCode": "const repos=$input.first().json.items;if(!Array.isArray(repos))return [{json:{action:'error'}}];return [{json:{action:'tools',items:repos.filter(r=>!r.archived&&!r.fork).map(r=>({title:r.full_name,source_url:r.html_url,summary:String(r.description||'Open-source AI project. Read the repository documentation and license.').slice(0,700)}))}}];"
